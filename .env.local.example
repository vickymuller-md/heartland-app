# ---- Supabase (required) ----
# Project URL and publishable (anon) key from Supabase dashboard -> API settings.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Service-role key (SERVER ONLY -- never expose to the browser).
# Used by the admin client for cron/server-actions that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- App ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Analytics (required for NIW evidence) ----
# GA4 Measurement ID (G-XXXXXXXXXX). If empty, GA4 is disabled cleanly.
# Create a property for heartlandprotocol.org before prod deploy.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Transactional email (optional) ----
# Resend API key for invites and provider notifications.
RESEND_API_KEY=

# ---- Sandbox AI-assisted check-in (optional; demo runs a deterministic
# form fallback when disabled) ----
# SERVER ONLY. Feature is on only when SANDBOX_AI_ENABLED=true AND a key is set.
# Volume caps live in migration 00033 (consume_sandbox_ai_turn), not in env.
ANTHROPIC_API_KEY=
SANDBOX_AI_ENABLED=false
SANDBOX_AI_MODEL=claude-sonnet-5

# ---- Sandbox live-call runtime voice (optional) ----
# SERVER ONLY. Speaks the assistant's dynamic lines in the simulated call.
# Only engine-decided text is synthesized (no public TTS surface); dynamic
# lines are capped at 300 chars and ride the same per-turn rate limit.
# Off (or key missing) -> the call continues with static clips + text.
# The same key also powers the local one-shot generator (npm run audio:outreach).
ELEVENLABS_API_KEY=
SANDBOX_TTS_ENABLED=false

# ---- Vercel cron auth (required in prod) ----
# Shared secret verified by /api/alert-scan and /api/health.
# Generate with: openssl rand -hex 32
CRON_SECRET=
